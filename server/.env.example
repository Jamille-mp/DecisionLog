DATABASE_URL="mysql://root:password@localhost:3306/decisionlog"
DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_USER="root"
DATABASE_PASSWORD="password"
DATABASE_NAME="decisionlog"
MONGODB_URL="mongodb://localhost:27017/decisionlog_logs"
JWT_SECRET="change-this-secret-with-at-least-32-characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=7
NODE_ENV="development"
PORT=3333
CLIENT_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
EVENT_BROKER_MODE="rabbitmq"
RABBITMQ_URL="amqp://localhost:5672"
RABBITMQ_EXCHANGE="decisionlog.events"
RABBITMQ_QUEUE="decisionlog.audit.events"

# OpenID Connect / OAuth2 institucional (opcional)
# Quando essas variáveis estiverem preenchidas, o frontend exibe o botão de SSO.
OIDC_PROVIDER_NAME="Login institucional"
OIDC_ISSUER_URL="https://seu-provedor.com"
OIDC_CLIENT_ID="decisionlog-client-id"
OIDC_CLIENT_SECRET="decisionlog-client-secret"
OIDC_REDIRECT_URI="http://localhost:3333/auth/oidc/callback"
OIDC_FRONTEND_REDIRECT_URL="http://localhost:5173"
OIDC_STATE_SECRET="change-this-oidc-state-secret-with-32-characters"

# Docker local
MYSQL_ROOT_PASSWORD="decisionlog_dev_password"
MYSQL_DATABASE="decisionlog"
RABBITMQ_DEFAULT_USER="decisionlog"
RABBITMQ_DEFAULT_PASS="decisionlog_dev_password"
