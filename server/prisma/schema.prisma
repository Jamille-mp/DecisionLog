generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  avatarUrl    String?    @db.MediumText
  preferredTheme String   @default("light")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  role         String     @default("manager")
  active       Boolean    @default(true)
  termsAcceptedAt DateTime?
  privacyAcceptedAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  decisions    Decision[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([companyId])
  @@map("users")
}

model Department {
  id        String     @id @default(uuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean    @default(true)
  deletedAt DateTime?
  decisions Decision[]
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Decision {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  title     String
  context   String   @db.Text
  decision  String   @db.Text
  reason    String   @db.Text
  department String   @default("Projeto")
  departmentId String?
  departmentRef Department? @relation(fields: [departmentId], references: [id])
  impact    String   @default("medium")
  status    String   @default("pending")
  active    Boolean  @default(true)
  deletedAt DateTime?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("decisions")
}

model Company {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  accessCode String         @unique
  logoUrl   String?         @db.MediumText
  active    Boolean         @default(true)
  domains   CompanyDomain[]
  users     User[]
  departments Department[]
  decisions Decision[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("companies")
}

model CompanyDomain {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  domain    String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("company_domains")
}
